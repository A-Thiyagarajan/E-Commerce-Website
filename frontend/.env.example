# Leave unset to use the local Vite proxy during development and the ShopStack
# Render API in production. Override when using a different API deployment.
# VITE_API_URL=https://your-backend.example.com/api

# Optional: override the local Vite proxy target for /api and /product-images.
# VITE_PROXY_TARGET=http://127.0.0.1:5000
