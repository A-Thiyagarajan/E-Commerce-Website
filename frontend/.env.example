# Leave unset for same-origin deployments. In local development, Vite proxies /api.
# Set this to the full API base URL only when the frontend and API are hosted separately.
# VITE_API_URL=https://api.example.com/api

# Optional: override the local Vite proxy target (defaults to http://127.0.0.1:5000).
# VITE_PROXY_TARGET=http://127.0.0.1:5000
